# =============================================================================
# research-assistant — environment configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#
#     cp env.example .env
#
# .env is gitignored — never commit your API keys or private paths.
#
# You do not need every key. One working model provider is enough to start.
# Sections marked [OPTIONAL] can be left empty.
# =============================================================================


# ── Core Application ─────────────────────────────────────────────────────────
# [REQUIRED] At least one model provider key from the sections below.

# Flask session encryption key. Auto-generated at startup if empty.
# [OPTIONAL] Set a fixed value to keep sessions valid across restarts.
FLASK_SECRET_KEY=

# Debug mode. Set to 1 to enable Flask debug (hot reload, detailed errors).
# [OPTIONAL] Do not use in production.
FLASK_DEBUG=0


# ── Web UI ───────────────────────────────────────────────────────────────────
# [OPTIONAL] Override the host and port the Flask app listens on.
RA_HOST=127.0.0.1
RA_PORT=5050

# [OPTIONAL] Browser command used by `ra open`.
RA_BROWSER=xdg-open


# ── Local Workspace Paths ────────────────────────────────────────────────────
# Main workspace folder. All outputs, drafts, evidence notes, sessions, logs,
# exports, and project files are stored here.
# [REQUIRED for workspace features]
THESIS_ROOT=/home/username/thesis

# Additional folder of PDFs to include in library searches (beyond Zotero).
# [OPTIONAL] Falls back to THESIS_ROOT if empty.
# THESIS_DOCS=/home/username/thesis/papers

# Alternative name for the same setting (deprecated — prefer THESIS_DOCS).
# THESIS_PDF_DIR=/home/username/thesis/papers

# Derived workspace directories (created automatically under THESIS_ROOT):
#
#   THESIS_ROOT/logs/              Model usage logs (YYYY-MM-DD.jsonl)
#   THESIS_ROOT/chroma_db/         Vector index (ChromaDB)
#   THESIS_ROOT/research_sessions/ Saved Q&A sessions
#   THESIS_ROOT/cache/             Cached API responses
#   THESIS_ROOT/runs/              Pipeline run artifacts
#   THESIS_ROOT/projects/          Project files and drafts


# ── Zotero ───────────────────────────────────────────────────────────────────
# Path to your local Zotero storage folder (contains PDF attachments).
# [REQUIRED for indexing, RAG, and citation-aware Q&A]
# Linux:   /home/username/Zotero/storage
# macOS:   /Users/username/Zotero/storage
# Windows: C:\Users\username\Zotero\storage
ZOTERO_STORAGE=/home/username/Zotero/storage

# Numeric Zotero user ID. Find it at https://www.zotero.org/settings/keys
# [REQUIRED for Zotero API metadata search and library browsing]
ZOTERO_USER_ID=

# Zotero API key with "read" access to your library.
# Create one at https://www.zotero.org/settings/keys
# [REQUIRED for Zotero API metadata search and library browsing]
ZOTERO_API_KEY=


# ── Vector Database & Embedding ──────────────────────────────────────────────
# ChromaDB is stored under THESIS_ROOT/chroma_db/ by default.
# [OPTIONAL] Override the embedding model used for the vector index.
# The default uses OpenAI embeddings (requires OPENAI_API_KEY).
# For a local alternative without API costs, use:
#   EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_MODEL=openai/text-embedding-3-small


# ── Anthropic (Claude) API ───────────────────────────────────────────────────
# [REQUIRED for claude, sonnet, haiku model aliases]
ANTHROPIC_API_KEY=sk-ant-...

# Alternative auth token for Anthropic API (used by the agentic pipeline).
# [OPTIONAL] Falls back to ANTHROPIC_API_KEY.
# ANTHROPIC_AUTH_TOKEN=sk-ant-...


# ── Claude CLI ───────────────────────────────────────────────────────────────
# Command used by the "claude-cli" model alias. The prompt is appended as the
# final argument. Requires the Claude Code CLI installed (`claude`).
# [OPTIONAL] Only needed if you use claude-cli routed calls.
CLAUDE_CLI_CMD=claude -p


# ── OpenAI API ───────────────────────────────────────────────────────────────
# [REQUIRED for gpt, gpt-mini model aliases]
OPENAI_API_KEY=sk-...


# ── Gemini API ───────────────────────────────────────────────────────────────
# [REQUIRED for gemini, flash model aliases]
GEMINI_API_KEY=...


# ── Gemini CLI ───────────────────────────────────────────────────────────────
# Command used by the "gemini-cli" model alias.
# [OPTIONAL] Only needed if you use gemini-cli routed calls.
GEMINI_CLI_CMD=gemini -p


# ── DeepSeek API ─────────────────────────────────────────────────────────────
# [REQUIRED for deepseek model alias]
DEEPSEEK_API_KEY=sk-...


# ── Codex CLI ────────────────────────────────────────────────────────────────
# Command used by the "codex-cli" model alias.
# [OPTIONAL] Only needed if you use codex-cli routed calls.
CODEX_CLI_CMD=codex exec


# ── Ollama (Local Models) ────────────────────────────────────────────────────
# Model string for the "local" alias (LiteLLM-managed API calls to Ollama).
# [OPTIONAL] Only needed if you use local models via Ollama.
OLLAMA_MODEL=ollama/llama3.3

# Command used by the "ollama-cli" model alias (CLI-routed passthrough).
# [OPTIONAL] Only needed if you use ollama-cli routed calls.
OLLAMA_CLI_CMD=ollama run llama3.3


# ── CLI Timeout ──────────────────────────────────────────────────────────────
# Maximum seconds before a CLI-routed model call is killed.
# [OPTIONAL] Default is 600 (10 minutes).
CLI_TIMEOUT=600


# ── Editor ───────────────────────────────────────────────────────────────────
# Text editor used by interactive review loops (paraphrase, critic).
# [OPTIONAL] Falls back to VISUAL, then nano.
EDITOR=nvim


# ── Elicit ───────────────────────────────────────────────────────────────────
# Elicit API key for paper discovery searches.
# [OPTIONAL] Requires a paid Elicit plan. https://elicit.com/
ELICIT_API_KEY=


# ── Semantic Scholar ─────────────────────────────────────────────────────────
# API key for higher rate limits on Semantic Scholar searches.
# [OPTIONAL] Works without a key at lower rate limits.
# Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=


# ── OpenAlex ─────────────────────────────────────────────────────────────────
# Email address for the OpenAlex "polite pool" — higher rate limits.
# [OPTIONAL] OpenAlex works without any key or email.
OPENALEX_EMAIL=


# ── Brave Search ─────────────────────────────────────────────────────────────
# API key for web search via Brave Search API.
# [OPTIONAL] Used by the agentic pipeline for literature research.
# Free tier: 2,000 queries/month. https://api.search.brave.com/app/
BRAVE_API_KEY=


# ── SerpAPI ──────────────────────────────────────────────────────────────────
# API key for web search via SerpAPI (alternative to Brave Search).
# [OPTIONAL] Used by the agentic pipeline search server.
SERPAPI_API_KEY=


# ── PaperForge ───────────────────────────────────────────────────────────────
# PaperForge is a multi-agent pipeline for academic paper generation.
# It uses the same model provider keys listed above (Anthropic, Gemini, etc.).
# No additional keys are required beyond your chosen model provider.
# [OPTIONAL] Available at /paperforge when the pipeline package is installed.


# ── PaperForge Server ────────────────────────────────────────────────────────
# [OPTIONAL] Override the host and port for the PaperForge sub-app.
# Only needed if you run the agentic pipeline web server separately.
# PF_HOST=127.0.0.1
# PF_PORT=5055


# ── Logging & AI Disclosure ──────────────────────────────────────────────────
# Model usage logs are saved under THESIS_ROOT/logs/ as YYYY-MM-DD.jsonl.
# The AI disclosure tool reads these logs to generate transparency statements.
# No additional configuration needed — logs are written automatically.
# [OPTIONAL] View disclosure statements at /disclosure.


# ── Model Alias Overrides ────────────────────────────────────────────────────
# Override the LiteLLM model string for any alias without editing source code.
# Pattern: RA_MODEL_<ALIAS>=provider/model-name  (uppercase, hyphens→underscores)
#
# All available aliases and their defaults:
#
#   RA_MODEL_CLAUDE=anthropic/claude-opus-4-8
#   RA_MODEL_SONNET=anthropic/claude-sonnet-4-6
#   RA_MODEL_HAIKU=anthropic/claude-haiku-4-5-20251001
#   RA_MODEL_GEMINI=gemini/gemini-2.5-pro
#   RA_MODEL_FLASH=gemini/gemini-2.5-flash
#   RA_MODEL_DEEPSEEK=deepseek/deepseek-chat
#   RA_MODEL_GPT=openai/gpt-5
#   RA_MODEL_GPT_MINI=openai/gpt-5-mini
#   RA_MODEL_CODEX=openai/gpt-5
#   RA_MODEL_LOCAL=ollama/llama3.3


# ── Advanced ─────────────────────────────────────────────────────────────────
# Override the path to the .env file (rarely needed).
# RA_ENV_FILE=/path/to/custom/.env

# Contact email used by external verification tools.
# [OPTIONAL] Falls back to OPENALEX_EMAIL.
# CONTACT_EMAIL=your.email@example.com
